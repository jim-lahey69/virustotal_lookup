# =============================================================================
# GTI / VirusTotal CVE Enricher — environment configuration
# =============================================================================
# Copy this file to ".env" in the project root and fill in real values:
#
#   copy .env.example .env          # Windows cmd
#   Copy-Item .env.example .env     # PowerShell
#
# IMPORTANT:
#   - Keep .env OUT of source control (it is listed in .gitignore).
#   - Never commit API keys or proxy credentials.
#   - The Python script loads this file via python-dotenv — you do NOT need to
#     set $env:HTTP_PROXY / $env:VIRUSTOTAL_API_KEY in every PowerShell session.
# =============================================================================

# --- Required: VirusTotal / GTI API key (Enterprise / Enterprise Plus + VI) ---
VIRUSTOTAL_API_KEY=your_key_here

# Optional alias (also accepted by the script):
# VT_API_KEY=your_key_here

# --- Corporate HTTP proxy (required on many enterprise networks) ---
HTTP_PROXY=http://webproxy:8080
HTTPS_PROXY=http://webproxy:8080

# Optional script-specific aliases:
# VT_HTTP_PROXY=http://webproxy:8080
# VT_HTTPS_PROXY=http://webproxy:8080

# --- Corporate SSL inspection (MITM) root CA ---
# Export your org root CA as PEM (or CRT), place it under certs/, then either:
#   1) Uncomment the line below, OR
#   2) Leave it commented — the script auto-uses ./certs/corporate-ca.pem when present.
#
# If you set this variable, the file MUST exist (misconfigured path = hard error).
# Do NOT disable TLS verification — the tool always verifies certificates.
# CORPORATE_CA_BUNDLE=./certs/corporate-ca.pem


# --- Optional tuning ---
# VT_REQUEST_DELAY=1.0
